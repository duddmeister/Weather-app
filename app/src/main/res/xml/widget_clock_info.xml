<?xml version="1.0" encoding="utf-8"?>
<!-- Attributes newer than minSdk are simply ignored on older launchers. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="io.github.duddmeister.weather.widget.WidgetConfigActivity"
    android:description="@string/widget_clock_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="100dp"
    android:maxResizeWidth="700dp"
    android:maxResizeHeight="400dp"
    android:previewLayout="@layout/widget_preview_clock"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional"
    tools:ignore="UnusedAttribute" />
